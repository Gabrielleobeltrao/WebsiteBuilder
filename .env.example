# Copy to .env and fill in. Never commit real values.
# Production values are configured per service in Coolify, not in this file.

# Shared public addresses.
# In production these are the real domain, e.g.:
#   PLATFORM_ROOT_DOMAIN=websitebuilder.oneplataforma.com
#   PLATFORM_PUBLIC_ORIGIN=https://websitebuilder.oneplataforma.com
PLATFORM_ROOT_DOMAIN=localhost
PLATFORM_PUBLIC_ORIGIN=http://localhost:5173
API_PUBLIC_BASE_PATH=/api
PLATFORM_RESERVED_SUBDOMAINS=www,app,api,admin,origin,customers,coolify,status,mail,cdn,assets,static,docs,support

# Frontend. Only public values belong here: everything prefixed VITE_ is bundled into code the
# browser downloads. A credential placed here is a published credential.
VITE_PUBLIC_ORIGIN=http://localhost:5173
VITE_API_URL=/api/v1

# Backend, auth and database
NODE_ENV=development
API_PORT=3000
PUBLIC_RENDERER_PORT=3001
LOG_LEVEL=info
FRONTEND_ORIGIN=http://localhost:5173
JSON_BODY_LIMIT=8mb
PUBLIC_REQUEST_TIMEOUT_MS=10000
SHUTDOWN_TIMEOUT_MS=30000
# Required in production. Startup fails naming the variable, never its value.
MONGODB_URI=
MONGODB_DB_NAME=
# At least 32 bytes. Generate with: openssl rand -base64 48
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:5173
BETTER_AUTH_BASE_PATH=/api/auth

# Gateway. Inside a single Compose stack the API answers on its service name; a deployment that
# runs the API as a separate Coolify resource sets this to that resource's internal address.
BACKEND_ORIGIN=http://backend:3000

# Public renderer for published customer sites. It needs its own hostname: sharing an origin with
# the application would put customer pages and the authenticated dashboard on one cookie domain.
#   PUBLIC_RENDERER_ORIGIN=https://origin.websitebuilder.oneplataforma.com
PUBLIC_RENDERER_ORIGIN=http://localhost:3001
PUBLIC_SITE_CACHE_TTL_SECONDS=60
DOMAIN_CACHE_TTL_SECONDS=60
PUBLISHED_VERSION_RETENTION_COUNT=20
PUBLISH_MAX_DOCUMENT_BYTES=4000000
# Coolify/Traefik proxy range. Forwarded headers are trusted from nothing until this is set.
# Determine the real proxy chain first: a range wider than the actual proxy lets anyone who can set
# X-Forwarded-Host choose which customer's site they are served.
TRUSTED_PROXY_CIDRS=

# Cloudflare for SaaS. Backend only: these never appear in a VITE_ variable, because everything
# prefixed VITE_ is downloaded by every visitor.
# Leave the token empty in development and the in-memory fake provider is used instead. In
# production, startup fails rather than promising customers a domain nobody registered.
# Token scope: Zone -> SSL and Certificates -> Edit, on the single zone below. Nothing broader.
CLOUDFLARE_API_BASE_URL=https://api.cloudflare.com/client/v4
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_API_TOKEN=
#   CLOUDFLARE_SAAS_CNAME_TARGET=customers.websitebuilder.oneplataforma.com
CLOUDFLARE_SAAS_CNAME_TARGET=customers.localhost
CLOUDFLARE_CUSTOM_HOSTNAME_SSL_METHOD=http
DOMAIN_VERIFICATION_INTERVAL_SECONDS=60
DOMAIN_VERIFICATION_TIMEOUT_HOURS=72

# Development only. Naming the seeded workspace opens /app/<id>/sites before Phase 7 wires real
# authentication. It must be unset in any deployed environment.
VITE_DEV_WORKSPACE=development-workspace
