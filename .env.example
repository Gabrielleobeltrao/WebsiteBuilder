# Environment files live next to the service that reads them:
#
#   backend/.env    Backend and public renderer (both are built from backend/Dockerfile)
#   frontend/.env   Frontend — currently empty by design, see that file
#
# This root file is still read first by the development scripts, so an existing local .env keeps
# working; values in backend/.env override it. Production values are set per Coolify resource and
# never in a file.
#
# Never commit real values.

# --- Development ports ---
# Change these when another project already holds one. The web port is read by Vite from this same
# file, and the three origins that describe the application — FRONTEND_ORIGIN,
# PLATFORM_PUBLIC_ORIGIN and BETTER_AUTH_URL — follow it unless they are set explicitly, so one
# value moves the whole stack. The dev server fails rather than quietly taking the next free port:
# a server that loads on a port the session cookie was not issued for is much harder to diagnose
# than "address already in use".
WEB_PORT=5173
API_PORT=3000
PUBLIC_RENDERER_PORT=3001

# --- Analytics ---
# Ingestion is off unless this is "true". Each site has its own switch as well; both must be open
# before a published page carries the tracker or the endpoint stores anything.
ANALYTICS_INGESTION_ENABLED=false
# Batches per minute. The address bucket is only applied where TRUSTED_PROXY_CIDRS is set — without
# it every visitor presents the gateway's address and would share one allowance.
ANALYTICS_RATE_LIMIT_PER_ADDRESS=60
ANALYTICS_RATE_LIMIT_PER_PROJECT=600
