# Copy to .env and fill in. Never commit real values.
# Production values are configured per service in Coolify, not in this file.

# Shared public addresses
PLATFORM_ROOT_DOMAIN=localhost
PLATFORM_PUBLIC_ORIGIN=http://localhost:5173
API_PUBLIC_BASE_PATH=/api
PLATFORM_RESERVED_SUBDOMAINS=www,app,api,admin,origin,customers,coolify,status,mail,cdn,assets,static,docs,support

# Frontend. Only public values belong here: everything prefixed VITE_ is bundled into code the
# browser downloads. A credential placed here is a published credential.
VITE_PUBLIC_ORIGIN=http://localhost:5173
VITE_API_URL=/api/v1

# Backend, auth and database
NODE_ENV=development
API_PORT=3000
PUBLIC_RENDERER_PORT=3001
LOG_LEVEL=info
FRONTEND_ORIGIN=http://localhost:5173
JSON_BODY_LIMIT=8mb
PUBLIC_REQUEST_TIMEOUT_MS=10000
SHUTDOWN_TIMEOUT_MS=30000
# Required in production. Startup fails naming the variable, never its value.
MONGODB_URI=
MONGODB_DB_NAME=

# Development only. Naming the seeded workspace opens /app/<id>/sites before Phase 7 wires real
# authentication. It must be unset in any deployed environment.
VITE_DEV_WORKSPACE=development-workspace
