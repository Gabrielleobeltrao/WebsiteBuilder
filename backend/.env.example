# Backend and public renderer.
#
# Copy to backend/.env for local development. Never commit real values. In production each of these
# is set on its own Coolify resource, not in a file.
#
# Both processes are built from backend/Dockerfile and share this schema; the renderer ignores the
# auth and gateway settings it has no use for.

NODE_ENV=development
LOG_LEVEL=info
API_PORT=3000
PUBLIC_RENDERER_PORT=3001
SHUTDOWN_TIMEOUT_MS=30000
PUBLIC_REQUEST_TIMEOUT_MS=10000
JSON_BODY_LIMIT=8mb

# Public addresses.
#
# The application and the API are separate hosts. PLATFORM_ROOT_DOMAIN is the parent of published
# customer sites and is deliberately not the application's domain. In production:
#   PLATFORM_PUBLIC_ORIGIN=https://websitebuilder.oneplataforma.com
#   PLATFORM_ROOT_DOMAIN=websitebuilder.oneplataforma.com
PLATFORM_ROOT_DOMAIN=localhost
PLATFORM_PUBLIC_ORIGIN=http://localhost:5173

# Development only. Production is same-origin -- the browser reaches the API through the gateway on
# the platform origin -- so no cross-origin allowance exists there at all.
FRONTEND_ORIGIN=http://localhost:5173
PLATFORM_RESERVED_SUBDOMAINS=www,app,api,admin,origin,customers,coolify,status,mail,cdn,assets,static,docs,support

# Required in production. Startup fails naming the variable, never its value.
MONGODB_URI=
MONGODB_DB_NAME=

# At least 32 bytes. Generate with: openssl rand -base64 48
BETTER_AUTH_SECRET=
# The application origin. The API answers under it at /api/auth, so the session cookie is issued for
# the origin the browser is already on.
BETTER_AUTH_URL=http://localhost:5173
BETTER_AUTH_BASE_PATH=/api/auth

# Public renderer. It needs its own hostname: sharing an origin with the application would put
# customer pages and the authenticated dashboard on one cookie domain.
#   PUBLIC_RENDERER_ORIGIN=https://origin.websitebuilder.oneplataforma.com
PUBLIC_RENDERER_ORIGIN=http://localhost:3001
PUBLIC_SITE_CACHE_TTL_SECONDS=60
DOMAIN_CACHE_TTL_SECONDS=60
PUBLISHED_VERSION_RETENTION_COUNT=20
PUBLISH_MAX_DOCUMENT_BYTES=4000000

# Coolify/Traefik proxy range. Empty means no forwarded header is believed, which is the safe
# default: the renderer identifies a tenant by hostname, and a range wider than the real proxy lets
# anyone who can set X-Forwarded-Host choose which customer's site they are served.
TRUSTED_PROXY_CIDRS=

# Cloudflare for SaaS, for customer domains. Backend only, and optional.
#
# Empty in development uses an in-memory fake. Empty in production the platform still runs — sites
# publish and serve on their platform hostnames — and only connecting a customer's own domain is
# refused, with a message saying so. What never happens is a customer being told their domain works
# while nothing was registered anywhere.
# Token scope: Zone -> SSL and Certificates -> Edit, on the single zone below. Nothing broader.
CLOUDFLARE_API_BASE_URL=https://api.cloudflare.com/client/v4
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_API_TOKEN=
#   CLOUDFLARE_SAAS_CNAME_TARGET=customers.websitebuilder.oneplataforma.com
CLOUDFLARE_SAAS_CNAME_TARGET=customers.localhost
CLOUDFLARE_CUSTOM_HOSTNAME_SSL_METHOD=http
DOMAIN_VERIFICATION_INTERVAL_SECONDS=60
DOMAIN_VERIFICATION_TIMEOUT_HOURS=72
