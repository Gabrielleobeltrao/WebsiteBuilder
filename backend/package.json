{
  "name": "@websitebuilder/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../.env src/server.ts",
    "dev:renderer": "tsx watch --env-file-if-exists=../.env src/renderer-server.ts",
    "build": "tsup",
    "start": "node dist/server.js",
    "start:renderer": "node dist/renderer-server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@websitebuilder/shared": "*",
    "better-auth": "^1.6.26",
    "cors": "^2.8.5",
    "express": "^5.0.1",
    "mongodb": "^7.5.0",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "sharp": "^0.35.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.7",
    "@types/supertest": "^6.0.2",
    "mongodb-memory-server": "^11.2.0",
    "supertest": "^7.0.0",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
